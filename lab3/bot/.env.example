# Токен бота от @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# База данных SQLite (по умолчанию tasks.db рядом с bot.py).
# На Railway, если к сервису подключён диск (volume), база сама кладётся на него — задавать не нужно.
# DB_FILE=tasks.db

# Старый файл с задачами из lab1. При первом запуске задачи из него переносятся в базу,
# а сам файл переименовывается в tasks.json.migrated (по умолчанию tasks.json рядом с bot.py)
# DATA_FILE=tasks.json

# Производственный календарь isdayoff.ru: по нему считаются рабочие дни, выходные и праздники.
# Чтобы проверить работу без календаря, поставьте неверный адрес, например
# https://isdayoff.ru/api/nothing — бот будет считать выходными только субботу и воскресенье.
CALENDAR_URL=https://isdayoff.ru/api/getdata

# Администратор бота (обычно это вы): ему приходят отзывы и доступна команда /admin.
# Узнать свой ID: запустите бота и отправьте ему /myid. Несколько ID — через запятую.
# Пусто — отзывы только сохраняются в базе, /admin недоступна.
ADMIN_ID=

# Webhook. На вашем компьютере не задавайте: бот, как раньше, сам забирает сообщения (long polling).
# На Railway адрес берётся сам из RAILWAY_PUBLIC_DOMAIN (Settings → Networking → Generate Domain),
# а порт — из PORT, который задаёт Railway. WEBHOOK_URL нужен, только если адрес другой (свой домен).
# WEBHOOK_URL=https://remindly.example.com
# PORT=8080
